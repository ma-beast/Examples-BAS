10 CLS
20 SCREEN 1,1
30 INK 255
40 PRINT AT 16,12;"ЗВЁЗДНЫЙ ЛОВЕЦ"
50 PRINT AT 19,8;"СИНИЕ ЗВЁЗДЫ = +1"
60 PRINT AT 21,6;"КРАСНЫЕ = -1 ЖИЗНЬ"
70 PRINT AT 23,11;"ВОДИ ПАЛЬЦЕМ"
80 PRINT AT 25,12;"ТАП ДЛЯ СТАРТА"
90 PAUSE

100 CLS
110 DIM SX(10)
120 DIM SY(10)
130 DIM SC(10)

140 SCORE=0
150 LIFE=5
160 SPEED=1
170 PX=30
180 PY=33

190 FOR I=1 TO 10
200 SX(I)=INT(RND*56)+2
210 SY(I)=INT(RND*25)+3
220 SC(I)=INT(RND*2)
230 NEXT I

240 INK 255
250 PRINT AT 1,1;"ОЧКИ ";SCORE
