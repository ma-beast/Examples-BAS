270 INK 48
280 PRINT AT PX,PY;"/A\"

300 REM ИГРОВОЙ ЦИКЛ

310 OX=PX
320 PX=INT(TOUCHX/4)

330 IF PX<2 THEN GOTO 350
340 IF PX>57 THEN GOTO 360
345 GOTO 370

350 PX=2
355 GOTO 370

360 PX=57

370 INK 0
380 PRINT AT OX,PY;"   "

390 INK 48
400 PRINT AT PX,PY;"/A\"

410 FOR I=1 TO 10

420 INK 0
430 PRINT AT SX(I),SY(I);" "

440 SY(I)=SY(I)+SPEED

450 IF SY(I)<33 THEN GOTO 520

460 IF SX(I)<PX-2 THEN GOTO 500
470 IF SX(I)>PX+2 THEN GOTO 500

480 IF SC(I)=0 THEN GOTO 540

490 LIFE=LIFE-1
500 SX(I)=INT(RND*56)+2
510 SY(I)=3
515 SC(I)=INT(RND*2)
520 GOTO 560

540 SCORE=SCORE+1
550 SX(I)=INT(RND*56)+2
555 SY(I)=3
558 SC(I)=INT(RND*2)

560 IF SY(I)>=33 THEN GOTO 600

570 IF SC(I)=0 THEN GOTO 590
580 INK 192
585 GOTO 600

590 INK 8
600 PRINT AT SX(I),SY(I);"*"

610 NEXT I

620 INK 255
630 PRINT AT 1,1;"ОЧКИ ";SCORE;"     "
640 PRINT AT 52,1;"ЖИЗНЬ ";LIFE;"     "

650 IF LIFE=0 THEN GOTO 800

660 SPEED=1+INT(SCORE/8)

670 IF SPEED>5 THEN GOTO 690
680 GOTO 700

690 SPEED=5

700 FOR J=1 TO 2
710 NEXT J

720 GOTO 300

800 rem CLS
810 INK 255
820 PRINT AT 15,20;"ИГРА ОКОНЧЕНА"
840 PLAY "C2D2E2C2"
841 for i =0 to 30
842 ink rnd*256
843 pcircle rnd*240,rnd*320,rnd*50
844 ink 255
845 PRINT AT rnd*60,rnd*40;"СЧЁТ ";SCORE
848 next
850 PAUSE
860 GOTO 10